module

public import Mathlib.Probability.Martingale.BorelCantelli
public import Mathlib.Probability.ConditionalExpectation
public import Mathlib.Probability.Independence.Basic

/-!

# The second Borel-Cantelli lemma

This file contains the *second Borel-Cantelli lemma* which states that, given a sequence of
independent sets `(sₙ)` in a probability space, if `∑ n, μ sₙ = ∞`, then the limsup of `sₙ` has
measure 1. We employ a proof using Lévy's generalized Borel-Cantelli by choosing an appropriate
filtration.

## Main result

- `ProbabilityTheory.measure_limsup_eq_one`: the second Borel-Cantelli lemma.

**Note**: for the *first Borel-Cantelli lemma*, which holds in general measure spaces (not only
in probability spaces), see `MeasureTheory.measure_limsup_atTop_eq_zero`.
-/

public section

open scoped ENNReal Topology
open MeasureTheory

namespace ProbabilityTheory

variable {Ω : Type*} {m0 : SigmaAlgebra Ω} {μ : Measure Ω}

section BorelCantelli

variable {ι β : Type*} [LinearOrder ι] [mβ : SigmaAlgebra β] [NormedAddCommGroup β]
  [BorelSpace β] {f : ι → Ω → β} {i j : ι} {s : ι → Set Ω}

theorem iIndepFun.indep_comap_natural_of_lt (hf : ∀ i, StronglyMeasurable (f i))
    (hfi : iIndepFun f μ) (hij : i < j) :
    Indep (SigmaAlgebra.comap (f j) mβ) (Filtration.natural f hf i) μ := by
  suffices Indep (⨆ k ∈ ({j} : Set ι), SigmaAlgebra.comap (f k) mβ)
      (⨆ k ∈ {k | k ≤ i}, SigmaAlgebra.comap (f k) mβ) μ by rwa [iSup_singleton] at this
  exact indep_iSup_of_disjoint (fun k => (hf k).measurable.comap_le) hfi (by simpa)

/-- For independent functions `f n`, the constant `∫ ω, f j ω ∂μ` is a conditional expectation of
an integrable `f j` given the natural filtration at a time `i < j`. -/
theorem iIndepFun.isCondExp_natural_of_lt [SecondCountableTopology β] [CompleteSpace β]
    [NormedSpace ℝ β] (hf : ∀ i, StronglyMeasurable (f i)) (hfi : iIndepFun f μ)
    (hij : i < j) (hfj : Integrable (f j) μ) :
    IsCondExp (Filtration.natural f hf i) μ (f j) fun _ ↦ ∫ ω, f j ω ∂μ :=
  isCondExp_integral_of_indep (hf j).measurable.comap_le (Filtration.le _ _)
    (comap_measurable <| f j).stronglyMeasurable.aestronglyMeasurable hfj
    (hfi.indep_comap_natural_of_lt hf hij)

/-- For independent sets `s n`, the constant `μ.real (s j)` is a conditional probability of `s j`
given the filtration generated by the sets at a time `i < j`, that is, a version of
`μ⟦s j | filtrationOfSet hsm i⟧`. -/
theorem iIndepSet.isCondExp_indicator_filtrationOfSet (hsm : ∀ n, MeasurableSet (s n))
    (hs : iIndepSet s μ) (hij : i < j) :
    IsCondExp (filtrationOfSet hsm i) μ ((s j).indicator fun _ ↦ (1 : ℝ))
      fun _ ↦ μ.real (s j) := by
  have : IsProbabilityMeasure μ := hs.isProbabilityMeasure
  have h := iIndepFun.isCondExp_natural_of_lt (β := ℝ)
    (fun n ↦ stronglyMeasurable_const.indicator (hsm n)) hs.iIndepFun_indicator hij
    ((integrable_const 1).indicator (hsm j))
  rw [integral_indicator_const _ (hsm j), smul_eq_mul, mul_one] at h
  rwa [Filtration.filtrationOfSet_eq_natural (β := fun _ ↦ ℝ) hsm]

open Filter

/-- **The second Borel-Cantelli lemma**: Given a sequence of independent sets `(sₙ)` such that
`∑ n, μ sₙ = ∞`, `limsup sₙ` has measure 1. -/
theorem measure_limsup_eq_one {s : ℕ → Set Ω} (hsm : ∀ n, MeasurableSet (s n)) (hs : iIndepSet s μ)
    (hs' : (∑' n, μ (s n)) = ∞) : μ (limsup s atTop) = 1 := by
  have : IsProbabilityMeasure μ := hs.isProbabilityMeasure
  -- the sum of the conditional probabilities `μ.real (s (k + 1))` diverges
  have h_sum : Tendsto (fun n => ∑ k ∈ Finset.range n, μ.real (s (k + 1))) atTop atTop := by
    have htends : Tendsto (fun n => ∑ k ∈ Finset.range n, μ (s (k + 1))) atTop (𝓝 ∞) := by
      rw [← ENNReal.tsum_add_one_eq_top hs' (measure_ne_top _ _)]
      exact ENNReal.tendsto_nat_tsum _
    rw [ENNReal.tendsto_nhds_top_iff_nnreal] at htends
    refine tendsto_atTop_atTop_of_monotone' ?_ ?_
    · refine monotone_nat_of_le_succ fun n => ?_
      rw [← sub_nonneg, Finset.sum_range_succ_sub_sum]
      exact ENNReal.toReal_nonneg
    · rintro ⟨B, hB⟩
      refine not_eventually.2 (Frequently.of_forall fun n => ?_) (htends B.toNNReal)
      rw [mem_upperBounds] at hB
      specialize hB (∑ k ∈ Finset.range n, μ (s (k + 1))).toReal _
      · refine ⟨n, ?_⟩
        rw [ENNReal.toReal_sum (by finiteness)]
        rfl
      · rwa [not_lt, ENNReal.ofNNReal_toNNReal, ENNReal.le_ofReal_iff_toReal_le]
        · simp
        · exact le_trans (by positivity) hB
  have h : ∀ᵐ ω ∂μ, ω ∈ limsup s atTop := by
    filter_upwards [ae_mem_limsup_atTop_iff (measurableSet_filtrationOfSet' hsm)
      fun n ↦ hs.isCondExp_indicator_filtrationOfSet hsm (Nat.lt_add_one n)] with ω hω
    exact hω.2 h_sum
  rw [measure_congr (eventuallyEqSet_univ.2 h : limsup s atTop =ᵐ[μ] Set.univ), measure_univ]

end BorelCantelli

end ProbabilityTheory
