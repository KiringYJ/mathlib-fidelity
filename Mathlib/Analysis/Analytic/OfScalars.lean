module

public import Mathlib.Analysis.Analytic.ConvergenceRadius

/-!
# Scalar series

This file contains API for analytic functions `∑ cᵢ • xⁱ` defined in terms of scalars
`c₀, c₁, c₂, …`.

## Main definitions / results:
* `FormalMultilinearSeries.ofScalars`: the formal power series `∑ cᵢ • xⁱ`.
* `FormalMultilinearSeries.ofScalarsSum`: the sum of such a power series, if it exists, and zero
  otherwise.
* `FormalMultilinearSeries.ofScalars_radius_eq_(zero/inv/top)_of_tendsto`:
  the ratio test for an analytic function defined in terms of a formal power series `∑ cᵢ • xⁱ`.
* `FormalMultilinearSeries.ofScalars_radius_eq_inv_of_tendsto_ENNReal`:
  the ratio test for an analytic function using `ENNReal.divInf` to include zero coefficients.
-/

@[expose] public section

namespace FormalMultilinearSeries

section Field

open ContinuousMultilinearMap

variable {𝕜 : Type*} (E : Type*) [Field 𝕜] [Ring E] [Algebra 𝕜 E] [TopologicalSpace E]
  [IsTopologicalRing E] {c : ℕ → 𝕜}

/-- Formal power series of `∑ cᵢ • xⁱ` for some scalar field `𝕜` and ring algebra `E` -/
def ofScalars (c : ℕ → 𝕜) : FormalMultilinearSeries 𝕜 E E :=
  fun n ↦ c n • ContinuousMultilinearMap.mkPiAlgebraFin 𝕜 n E

@[simp]
theorem ofScalars_eq_zero [Nontrivial E] (n : ℕ) : ofScalars E c n = 0 ↔ c n = 0 := by
  constructor
  · intro h
    have he := congrArg
      (fun f : ContinuousMultilinearMap 𝕜 (fun _ : Fin n => E) E => f (fun _ => 1)) h
    have hz : algebraMap 𝕜 E (c n) = 0 := by
      simpa [ofScalars, Algebra.smul_def] using he
    exact (map_eq_zero (algebraMap 𝕜 E)).mp hz
  · intro h
    rw [ofScalars, h, zero_smul 𝕜 (ContinuousMultilinearMap.mkPiAlgebraFin 𝕜 n E)]


@[simp]
theorem ofScalars_eq_zero_of_scalar_zero {n : ℕ} (hc : c n = 0) : ofScalars E c n = 0 := by
  rw [ofScalars, hc, zero_smul 𝕜 (ContinuousMultilinearMap.mkPiAlgebraFin 𝕜 n E)]

@[simp]
theorem ofScalars_series_eq_zero [Nontrivial E] : ofScalars E c = 0 ↔ c = 0 := by
  simp [FormalMultilinearSeries.ext_iff, funext_iff]

variable (𝕜) in
@[simp]
theorem ofScalars_series_eq_zero_of_scalar_zero : ofScalars E (0 : ℕ → 𝕜) = 0 := by
  simp [FormalMultilinearSeries.ext_iff]

@[simp]
theorem ofScalars_series_of_subsingleton [Subsingleton E] : ofScalars E c = 0 := by
  simp_rw [FormalMultilinearSeries.ext_iff, ofScalars, ContinuousMultilinearMap.ext_iff]
  exact fun _ _ ↦ Subsingleton.allEq _ _

variable (𝕜) in
theorem ofScalars_series_injective [Nontrivial E] : Function.Injective (ofScalars E (𝕜 := 𝕜)) := by
  intro _ _ h
  ext n
  simpa [ofScalars] using congrArg (fun p ↦ p n fun _ ↦ (1 : E)) h

variable (c)

@[simp]
theorem ofScalars_series_eq_iff [Nontrivial E] (c' : ℕ → 𝕜) :
    ofScalars E c = ofScalars E c' ↔ c = c' :=
  ⟨fun e => ofScalars_series_injective 𝕜 E e, _root_.congrArg _⟩

theorem ofScalars_apply_zero (n : ℕ) :
    ofScalars E c n (fun _ => 0) = Pi.single (M := fun _ => E) 0 (c 0 • 1) n := by
  rw [ofScalars]
  cases n <;> simp

@[simp]
lemma coeff_ofScalars {𝕜 : Type*} [NontriviallyNormedField 𝕜] {p : ℕ → 𝕜} {n : ℕ} :
    (FormalMultilinearSeries.ofScalars 𝕜 p).coeff n = p n := by
  simp [FormalMultilinearSeries.coeff, FormalMultilinearSeries.ofScalars, List.prod_ofFn]

theorem ofScalars_add (c' : ℕ → 𝕜) : ofScalars E (c + c') = ofScalars E c + ofScalars E c' := by
  ext; simp [ofScalars, add_smul]

lemma ofScalars_sub (c' : ℕ → 𝕜) : ofScalars E (c - c') = ofScalars E c - ofScalars E c' := by
  ext; simp [ofScalars, sub_smul]

theorem ofScalars_smul (x : 𝕜) : ofScalars E (x • c) = x • ofScalars E c := by
  ext; simp [ofScalars, smul_smul]

theorem ofScalars_comp_neg_id :
    (ofScalars E c).compContinuousLinearMap (-ContinuousLinearMap.id _ _) =
    (ofScalars E (fun k ↦ (-1) ^ k * c k)) := by
  ext n
  rcases n.even_or_odd with (h | h) <;>
  simp [ofScalars, show ((-ContinuousLinearMap.id 𝕜 E : _) : E → E) = Neg.neg by rfl,
    ← List.map_ofFn, h.neg_one_pow]

theorem ofScalars_comp_neg (f : E →L[𝕜] E) :
    (ofScalars E c).compContinuousLinearMap (-f) =
    (ofScalars E (fun k ↦ (-1) ^ k * c k)).compContinuousLinearMap f := by
  conv => lhs; rw [← ContinuousLinearMap.id_comp f, ← ContinuousLinearMap.neg_comp]
  rw [← FormalMultilinearSeries.compContinuousLinearMap_comp, ofScalars_comp_neg_id]

variable (𝕜) in
/-- The submodule generated by scalar series on `FormalMultilinearSeries 𝕜 E E`. -/
def ofScalarsSubmodule : Submodule 𝕜 (FormalMultilinearSeries 𝕜 E E) where
  carrier := {ofScalars E f | f}
  add_mem' := fun ⟨c, hc⟩ ⟨c', hc'⟩ ↦ ⟨c + c', hc' ▸ hc ▸ ofScalars_add E c c'⟩
  zero_mem' := ⟨0, ofScalars_series_eq_zero_of_scalar_zero 𝕜 E⟩
  smul_mem' := fun x _ ⟨c, hc⟩ ↦ ⟨x • c, hc ▸ ofScalars_smul E c x⟩

variable {E}

theorem ofScalars_apply_eq (x : E) (n : ℕ) :
    ofScalars E c n (fun _ ↦ x) = c n • x ^ n := by
  simp [ofScalars]

/-- This naming follows the convention of `NormedSpace.expSeries_apply_eq'`. -/
theorem ofScalars_apply_eq' (x : E) :
    (fun n ↦ ofScalars E c n (fun _ ↦ x)) = fun n ↦ c n • x ^ n := by
  simp [ofScalars]

/-- The sum of the formal power series. Takes the value `0` outside the radius of convergence. -/
noncomputable def ofScalarsSum := (ofScalars E c).sum

theorem ofScalars_sum_eq (x : E) : ofScalarsSum c x =
    ∑' n, c n • x ^ n := tsum_congr fun n => ofScalars_apply_eq c x n

theorem ofScalarsSum_eq_tsum : ofScalarsSum c =
    fun (x : E) => ∑' n : ℕ, c n • x ^ n := funext (ofScalars_sum_eq c)

@[simp]
theorem ofScalarsSum_zero : ofScalarsSum c (0 : E) = c 0 • 1 := by
  simp [ofScalarsSum_eq_tsum, ← ofScalars_apply_eq, ofScalars_apply_zero]

@[simp]
theorem ofScalarsSum_of_subsingleton [Subsingleton E] {x : E} : ofScalarsSum c x = 0 := by
  simp [Subsingleton.eq_zero (α := E)]

@[simp]
theorem ofScalarsSum_op [T2Space E] (x : E) :
    ofScalarsSum c (MulOpposite.op x) = MulOpposite.op (ofScalarsSum c x) := by
  simp [ofScalars_sum_eq, ← MulOpposite.op_pow, ← MulOpposite.op_smul, tsum_op]

@[simp]
theorem ofScalarsSum_unop [T2Space E] (x : Eᵐᵒᵖ) :
    ofScalarsSum c (MulOpposite.unop x) = MulOpposite.unop (ofScalarsSum c x) := by
  simp [ofScalars_sum_eq, ← MulOpposite.unop_pow, ← MulOpposite.unop_smul, tsum_unop]

end Field

section Seminormed

open scoped Topology NNReal

variable {𝕜 : Type*} (E : Type*) [NontriviallyNormedField 𝕜] [SeminormedRing E]
    [NormedAlgebra 𝕜 E] (c : ℕ → 𝕜) (n : ℕ)

@[simp]
theorem ofScalars_norm_eq_mul :
    ‖ofScalars E c n‖ = ‖c n‖ * ‖ContinuousMultilinearMap.mkPiAlgebraFin 𝕜 n E‖ := by
  rw [ofScalars, norm_smul]

theorem ofScalars_norm_le (hn : n > 0) : ‖ofScalars E c n‖ ≤ ‖c n‖ := by
  simp only [ofScalars_norm_eq_mul]
  exact (mul_le_of_le_one_right (norm_nonneg _)
    (ContinuousMultilinearMap.norm_mkPiAlgebraFin_le_of_pos hn))

theorem ofScalars_norm [NormOneClass E] : ‖ofScalars E c n‖ = ‖c n‖ := by
  simp

end Seminormed

section Normed

open Filter ENNReal
open scoped Topology NNReal

variable {𝕜 : Type*} (E : Type*) [NontriviallyNormedField 𝕜] [NormedRing E]
    [NormedAlgebra 𝕜 E] (c : ℕ → 𝕜) (n : ℕ)

private theorem tendsto_succ_norm_div_norm {r r' : ℝ≥0} (hr' : r' ≠ 0)
    (hc : Tendsto (fun n : {n : ℕ // ‖c n‖ ≠ 0} ↦
      Checked.div ‖c n.1.succ‖ ‖c n.1‖ n.2.isUnit) (comap Subtype.val atTop) (𝓝 r)) :
    Tendsto (fun n : {n : ℕ // ‖‖c n‖ * (r' : ℝ) ^ n‖ ≠ 0} ↦
      Checked.div ‖‖c (n.1 + 1)‖ * (r' : ℝ) ^ (n.1 + 1)‖
        ‖‖c n.1‖ * (r' : ℝ) ^ n.1‖ n.2.isUnit)
      (comap Subtype.val atTop) (𝓝 ↑(r' * r)) := by
  let φ : {n : ℕ // ‖‖c n‖ * (r' : ℝ) ^ n‖ ≠ 0} → {n : ℕ // ‖c n‖ ≠ 0} :=
    fun n => ⟨n.1, fun hn => n.2 (by simp [hn])⟩
  have hφ : Tendsto φ (comap Subtype.val atTop) (comap Subtype.val atTop) :=
    tendsto_comap_iff.mpr tendsto_comap
  have hlim := (hc.comp hφ).mul_const (r' : ℝ)
  rw [show (r : ℝ) * r' = ↑(r' * r) by simp [mul_comm]] at hlim
  refine hlim.congr fun n => ?_
  have hcn : ‖c n.1‖ ≠ 0 := (φ n).2
  have hr₀ : (r' : ℝ) ≠ 0 := NNReal.coe_ne_zero.mpr hr'
  change (‖c n.1.succ‖ / ‖c n.1‖) * (r' : ℝ) =
    ‖‖c (n.1 + 1)‖ * (r' : ℝ) ^ (n.1 + 1)‖ / ‖‖c n.1‖ * (r' : ℝ) ^ n.1‖
  simp only [norm_mul, norm_norm, norm_pow, NNReal.norm_eq, pow_succ]
  field

private theorem eventually_ne_zero_of_ratio_pos {r : ℝ≥0} (hr : r ≠ 0)
    (hf : ∃ᶠ n in atTop, c n ≠ 0)
    (hc : Tendsto (fun n : {n : ℕ // ‖c n‖ ≠ 0} ↦
      Checked.div ‖c n.1.succ‖ ‖c n.1‖ n.2.isUnit) (comap Subtype.val atTop) (𝓝 r)) :
    ∀ᶠ n in atTop, c n ≠ 0 := by
  have he := hc.eventually_const_lt (NNReal.coe_pos.mpr (pos_iff_ne_zero.mpr hr))
  rw [eventually_comap, eventually_atTop] at he
  obtain ⟨N, hN⟩ := he
  obtain ⟨M, hMN, hM⟩ := frequently_atTop.mp hf N
  refine eventually_atTop.mpr ⟨M, fun n hn => ?_⟩
  induction n, hn using Nat.le_induction with
  | base => exact hM
  | succ n hn ih =>
      have hpos := hN n (hMN.trans hn) ⟨n, norm_ne_zero_iff.mpr ih⟩ rfl
      intro heq
      simp [heq] at hpos

theorem inv_le_ofScalars_radius_of_tendsto {r : ℝ≥0} (hr : r ≠ 0)
    (hc : Tendsto (fun n : {n : ℕ // ‖c n‖ ≠ 0} ↦
      Checked.div ‖c n.1.succ‖ ‖c n.1‖ n.2.isUnit) (comap Subtype.val atTop) (𝓝 r)) :
      ofNNReal r⁻¹ ≤ (ofScalars E c).radius := by
  by_cases hf : ∃ᶠ n in atTop, c n ≠ 0
  · have hce := eventually_ne_zero_of_ratio_pos c hr hf hc
    refine le_of_forall_nnreal_lt (fun r' hr' ↦ ?_)
    rw [coe_lt_coe, NNReal.lt_inv_iff_mul_lt] at hr'
    by_cases hrz : r' = 0
    · simp [hrz]
    apply FormalMultilinearSeries.le_radius_of_summable_norm
    refine Summable.of_norm_bounded_eventually (g := fun n ↦ ‖c n‖ * r' ^ n) ?_ ?_
    · refine summable_of_ratio_test_tendsto_lt_one (show (↑(r' * r) : ℝ) < 1 from hr') ?_ ?_
      · filter_upwards [hce] with n hn
        simp [hn, hrz]
      · simpa only [norm_norm] using tendsto_succ_norm_div_norm c hrz hc
    · filter_upwards [eventually_cofinite_ne 0] with n hn
      simp only [norm_mul, norm_norm, norm_pow, NNReal.norm_eq]
      gcongr
      exact ofScalars_norm_le E c n (Nat.pos_iff_ne_zero.mpr hn)
  · have hz : ∀ᶠ n in atTop, c n = 0 := by simpa only [not_frequently, not_not] using hf
    have hrad := (ofScalars E c).radius_eq_top_of_eventually_eq_zero
      (hz.mono fun n hn => ofScalars_eq_zero_of_scalar_zero E hn)
    simp [hrad]

/-- A nonzero finite limit of the coefficient ratios determines the radius, provided
nonzero coefficients occur arbitrarily far out. Ratios are taken on their exact domain. -/
theorem ofScalars_radius_eq_inv_of_tendsto [NormOneClass E] {r : ℝ≥0} (hr : r ≠ 0)
    (hf : ∃ᶠ n in atTop, c n ≠ 0)
    (hc : Tendsto (fun n : {n : ℕ // ‖c n‖ ≠ 0} ↦
      Checked.div ‖c n.1.succ‖ ‖c n.1‖ n.2.isUnit) (comap Subtype.val atTop) (𝓝 r)) :
      (ofScalars E c).radius = ofNNReal r⁻¹ := by
  refine le_antisymm ?_ (inv_le_ofScalars_radius_of_tendsto E c hr hc)
  refine le_of_forall_nnreal_lt (fun r' hr' ↦ ?_)
  rw [coe_le_coe, NNReal.le_inv_iff_mul_le]
  have hs := FormalMultilinearSeries.summable_norm_mul_pow (ofScalars E c) hr'
  contrapose! hs
  have hrz : r' ≠ 0 := by intro hz; simp [hz] at hs
  simp only [ofScalars_norm] at *
  refine not_summable_of_ratio_test_tendsto_gt_one (show (1 : ℝ) < ↑(r' * r) from hs) ?_ ?_
  · exact hf.mono fun n hn => by simp [hn, hrz]
  · exact tendsto_succ_norm_div_norm c hrz hc

/-- The inverse coefficient ratio determines the radius on its exact denominator domain. -/
theorem ofScalars_radius_eq_of_tendsto [NormOneClass E] {r : NNReal} (hr : r ≠ 0)
    (hf : ∃ᶠ n in atTop, c n ≠ 0)
    (hc : Tendsto (fun n : {n : ℕ // ‖c n.succ‖ ≠ 0} ↦
      Checked.div ‖c n.1‖ ‖c n.1.succ‖ n.2.isUnit) (comap Subtype.val atTop) (𝓝 r)) :
      (ofScalars E c).radius = ofNNReal r := by
  have he := hc.eventually_const_lt (NNReal.coe_pos.mpr (pos_iff_ne_zero.mpr hr))
  rw [eventually_comap, eventually_atTop] at he
  obtain ⟨N, hN⟩ := he
  have hce : ∀ᶠ n in atTop, c n ≠ 0 := by
    refine eventually_atTop.mpr ⟨N, fun n hn hcn => ?_⟩
    obtain ⟨m, hmn, hm⟩ := frequently_atTop.mp hf n
    have hz : c m = 0 := by
      clear hm
      induction m, hmn using Nat.le_induction with
      | base => exact hcn
      | succ m hmn ih =>
          by_contra hm'
          have hp := hN m (hn.trans hmn) ⟨m, norm_ne_zero_iff.mpr hm'⟩ rfl
          simp [ih] at hp
    exact hm hz
  have hforward : Tendsto (fun n : {n : ℕ // ‖c n‖ ≠ 0} ↦
      Checked.div ‖c n.1.succ‖ ‖c n.1‖ n.2.isUnit)
      (comap Subtype.val atTop) (𝓝 ((r : ℝ)⁻¹)) := by
    have hnext : ∀ᶠ n : {n : ℕ // ‖c n‖ ≠ 0} in comap Subtype.val atTop,
        ‖c n.1.succ‖ ≠ 0 :=
      tendsto_comap.eventually ((tendsto_add_atTop_nat 1).eventually
        (hce.mono fun n hn => norm_ne_zero_iff.mpr hn))
    apply (tendsto_comap_val_iff hnext).mp
    let φ : {n : {n : ℕ // ‖c n‖ ≠ 0} // ‖c n.1.succ‖ ≠ 0} →
        {n : ℕ // ‖c n.succ‖ ≠ 0} := fun n => ⟨n.1.1, n.2⟩
    have hφ : Tendsto φ (comap Subtype.val (comap Subtype.val atTop))
        (comap Subtype.val atTop) := by
      apply tendsto_comap_iff.mpr
      change Tendsto (fun n : {n : {n : ℕ // ‖c n‖ ≠ 0} // ‖c n.1.succ‖ ≠ 0} => n.1.1) _ atTop
      exact tendsto_comap.comp tendsto_comap
    have hi := (hc.comp hφ).inv₀
      (h0 := fun n => (div_ne_zero n.1.2).isUnit)
      (ha := (NNReal.coe_ne_zero.mpr hr).isUnit)
    simpa only [φ, Function.comp_def, inv_div₀] using hi
  have hi := ofScalars_radius_eq_inv_of_tendsto E c (inv_ne_zero (ha := hr.isUnit)) hf
    (by simpa only [NNReal.coe_inv] using hforward)
  simpa only [inv_inv₀] using hi

/-- If the coefficient ratio tends to zero on its domain and coefficients are eventually
nonzero, the radius is unbounded. The nonvanishing condition rules out arbitrarily late
restarts after zero coefficients, which the restricted ratio does not see. -/
theorem ofScalars_radius_eq_top_of_tendsto (hc : ∀ᶠ n in atTop, c n ≠ 0)
    (hc' : Tendsto (fun n : {n : ℕ // ‖c n‖ ≠ 0} ↦
      Checked.div ‖c n.1.succ‖ ‖c n.1‖ n.2.isUnit)
      (comap Subtype.val atTop) (𝓝 0)) : (ofScalars E c).radius = ⊤ := by
  refine radius_eq_top_of_summable_norm _ fun r' ↦ ?_
  by_cases hrz : r' = 0
  · apply Summable.comp_nat_add (k := 1)
    simp [hrz]
  · refine Summable.of_norm_bounded_eventually (g := fun n ↦ ‖c n‖ * r' ^ n) ?_ ?_
    · refine summable_of_ratio_test_tendsto_lt_one zero_lt_one ?_ ?_
      · filter_upwards [hc] with n hn
        simp [hn, hrz]
      · simpa only [norm_norm, mul_zero, NNReal.coe_zero] using
          tendsto_succ_norm_div_norm c hrz (r := 0) hc'
    · filter_upwards [eventually_cofinite_ne 0] with n hn
      simp only [norm_mul, norm_norm, norm_pow, NNReal.norm_eq]
      gcongr
      exact ofScalars_norm_le E c n (Nat.pos_iff_ne_zero.mpr hn)

/-- An unbounded coefficient ratio on its domain forces radius zero when nonzero
coefficients occur arbitrarily far out. -/
theorem ofScalars_radius_eq_zero_of_tendsto [NormOneClass E]
    (hf : ∃ᶠ n in atTop, c n ≠ 0)
    (hc : Tendsto (fun n : {n : ℕ // ‖c n‖ ≠ 0} ↦
      Checked.div ‖c n.1.succ‖ ‖c n.1‖ n.2.isUnit)
      (comap Subtype.val atTop) atTop) : (ofScalars E c).radius = 0 := by
  suffices (ofScalars E c).radius ≤ 0 by simp_all
  refine le_of_forall_nnreal_lt (fun r hr ↦ ?_)
  rw [← coe_zero, coe_le_coe]
  have hs := FormalMultilinearSeries.summable_norm_mul_pow (ofScalars E c) hr
  contrapose! hs
  have hr₀ : (r : ℝ) ≠ 0 := ne_of_gt hs
  refine not_summable_of_ratio_norm_eventually_ge (r := 2) (by norm_num) ?_ ?_
  · exact hf.mono fun n hn => by simp [hn, hr₀]
  · have he := hc.eventually_ge_atTop (2 * (r : ℝ)⁻¹)
    rw [eventually_comap] at he
    filter_upwards [he] with n hn
    simp only [ofScalars_norm, norm_mul, norm_norm, norm_pow, NNReal.norm_eq]
    by_cases hcn : c n = 0
    · simp only [hcn, norm_zero, zero_mul, mul_zero]
      positivity
    · have hineq := (le_div_iff₀ (norm_pos_iff.mpr hcn)).mp
        (hn ⟨n, norm_ne_zero_iff.mpr hcn⟩ rfl)
      calc
        2 * (‖c n‖ * (r : ℝ) ^ n) =
            (2 * (r : ℝ)⁻¹ * ‖c n‖) * (r : ℝ) ^ (n + 1) := by
          rw [pow_succ]
          field
        _ ≤ ‖c (n + 1)‖ * (r : ℝ) ^ (n + 1) :=
          mul_le_mul_of_nonneg_right hineq (pow_nonneg r.coe_nonneg _)

/-- The limit of the coefficient ratios defined by `ENNReal.divInf` determines the radius.
A pair of zero coefficients has ratio zero. -/
theorem ofScalars_radius_eq_inv_of_tendsto_ENNReal [NormOneClass E] {r : ℝ≥0∞}
    (hc' : Tendsto (fun n ↦ ENNReal.divInf (ENNReal.ofReal ‖c n.succ‖) (ENNReal.ofReal ‖c n‖))
      atTop (𝓝 r)) :
      (ofScalars E c).radius = r⁻¹ := by
  have hce (hr : r ≠ 0) : ∀ᶠ n in atTop, c n ≠ 0 := by
    have hn := hc'.eventually_ne hr
    have hnext : ∀ᶠ n in atTop, c (n + 1) ≠ 0 := by
      filter_upwards [hn] with n hn he
      simp [ENNReal.divInf, he] at hn
    obtain ⟨N, hN⟩ := eventually_atTop.mp hnext
    refine eventually_atTop.mpr ⟨N + 1, fun n hn => ?_⟩
    cases n with
    | zero => omega
    | succ n => exact hN n (by omega)
  rcases ENNReal.trichotomy r with (hr | hr | hr)
  · simp_rw [hr, inv_zero] at hc' ⊢
    by_cases h : (∀ᶠ (n : ℕ) in atTop, c n ≠ 0)
    · apply ofScalars_radius_eq_top_of_tendsto E c h
      have ht := ((tendsto_toReal zero_ne_top).comp hc').comp
        (tendsto_comap : Tendsto (Subtype.val : {n : ℕ // ‖c n‖ ≠ 0} → ℕ) _ atTop)
      convert ht using 1
      · funext n
        have hn : (ENNReal.ofReal ‖c n.1‖).toReal ≠ 0 := by simpa using n.2
        simp only [Function.comp_def, ENNReal.divInf, ENNReal.toReal_mul,
          ENNReal.toReal_inv _ (ha := hn.isUnit), ENNReal.toReal_ofReal (norm_nonneg _),
          div_eq_mul_inv₀]
      · simp
    · apply (ofScalars E c).radius_eq_top_of_eventually_eq_zero
      simp only [eventually_atTop, not_exists, not_forall, not_not] at h ⊢
      obtain ⟨ti, hti⟩ := eventually_atTop.mp (hc'.eventually_ne zero_ne_top)
      obtain ⟨zi, hzi, z⟩ := h ti
      refine ⟨zi, Nat.le_induction (ofScalars_eq_zero_of_scalar_zero E z) fun n hmn a ↦ ?_⟩
      nontriviality E
      simp only [ofScalars_eq_zero] at a ⊢
      contrapose! hti
      exact ⟨n, hzi.trans hmn, ENNReal.divInf_eq_top.mpr (by simp [a, hti])⟩
  · have hne := hce (by simpa only [hr] using (top_ne_zero : (∞ : ℝ≥0∞) ≠ 0))
    simp_rw [hr, inv_top] at hc' ⊢
    apply ofScalars_radius_eq_zero_of_tendsto E c hne.frequently
    apply tendsto_ofReal_nhds_top.mp
    convert hc'.comp (tendsto_comap :
      Tendsto (Subtype.val : {n : ℕ // ‖c n‖ ≠ 0} → ℕ) _ atTop) using 1
    funext n
    exact ofReal_div_of_pos (lt_of_le_of_ne (norm_nonneg _) n.2.symm)
  · have hr' := toReal_ne_zero.mp hr.ne.symm
    have hr'' := toNNReal_ne_zero.mpr hr'
    have hlim : Tendsto (fun n : {n : ℕ // ‖c n‖ ≠ 0} ↦
        Checked.div ‖c n.1.succ‖ ‖c n.1‖ n.2.isUnit)
        (comap Subtype.val atTop) (𝓝 ↑r.toNNReal) := by
      have ht := ((tendsto_toReal hr'.2).comp hc').comp
        (tendsto_comap : Tendsto (Subtype.val : {n : ℕ // ‖c n‖ ≠ 0} → ℕ) _ atTop)
      convert ht using 1
      · funext n
        have hn : (ENNReal.ofReal ‖c n.1‖).toReal ≠ 0 := by simpa using n.2
        simp only [Function.comp_def, ENNReal.divInf, ENNReal.toReal_mul,
          ENNReal.toReal_inv _ (ha := hn.isUnit), ENNReal.toReal_ofReal (norm_nonneg _),
          div_eq_mul_inv₀]
      · rfl
    rw [ofScalars_radius_eq_inv_of_tendsto E c hr'' (hce hr'.1).frequently hlim,
      ENNReal.coe_inv, ENNReal.coe_toNNReal hr'.2]

end Normed

end FormalMultilinearSeries
